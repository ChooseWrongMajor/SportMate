aws_region  = "ap-southeast-1"
project_name = "sportmate"
environment = "dev"

vpc_cidr = "10.0.0.0/16"

availability_zone_a = "ap-southeast-1a"
availability_zone_b = "ap-southeast-1b"

public_subnet_a_cidr = "10.0.1.0/24"
public_subnet_b_cidr = "10.0.3.0/24"

private_subnet_a_cidr = "10.0.2.0/24"
private_subnet_b_cidr = "10.0.4.0/24"

instance_type = "t3.micro"

ami_id = "ami-XXXXXXXXXXXXXXXXX"

key_name = "SportMateEC2KeyPair"

my_ip = "YOUR_PUBLIC_IP/32"

frontend_bucket_name = "sportmate-frontend-your-unique-name"